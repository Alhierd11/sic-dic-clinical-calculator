<Application x:Class="SicDic.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Style TargetType="TextBox"><Setter Property="MinHeight" Value="40"/><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,2,0,12"/></Style>
    <Style TargetType="Button"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,8,8,8"/></Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="40"/><Setter Property="Margin" Value="0,2,0,12"/></Style>
    <Style TargetType="CheckBox"><Setter Property="MinHeight" Value="44"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  </Application.Resources>
</Application>
